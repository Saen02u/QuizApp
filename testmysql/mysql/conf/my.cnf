[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqld]
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
skip-character-set-client-handshake = FALSE
general_log = ON
log_output=FILE
general_log_file=/var/lib/mysql/log/mysql.log
log_error=/var/lib/mysql/log/mysql-error.log
slow_query_log = ON
slow_query_log_file=/var/lib/mysql/log/mysql-slowquery.log
long-query_time = 2
log-queries-not-using-indexes
